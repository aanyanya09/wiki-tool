<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='stylesheet.css') }}">
</head>
<body>

    <div>
        <h1 style="text-align: center; margin-top: 40px; margin-bottom: 10px;">CREATE ACCOUNT</h1>
        <h2 style="text-align: center; margin-bottom: 30px;">Join us today!</h2>

        <form>
            <!-- Email Field -->
            <div class="hero">
                <label for="email">Email Address:</label>
                <input type="email" id="email" placeholder="Enter your email..." required>
            </div>

            <!-- Username Field -->
            <div class="hero">
                <label for="username">Username:</label>
                <input type="text" id="username" placeholder="Create a username..." required>
            </div>

            <!-- Password Field -->
            <div class="hero">
                <label for="password">Password:</label>
                <input type="password" id="password" placeholder="Create a password..." required>
            </div>

            <!-- Confirm Password Field -->
            <div class="hero">
                <label for="confirm-password">Confirm Password:</label>
                <input type="password" id="confirm-password" placeholder="Repeat your password..." required>
            </div>

            <div class="hero">
                <label for="Role">Role</label>
                <input type="text" id="Role" required>
            </div>

            <div class="hero">
                <label for ="skills">skills</label>
                <input type="text" id="skills" required>
            </div>

            <div class="hero">
                <label for="Experience-level">Experience-level</label>
                 <select name="category" id="Experience-level">
                    <option value="biginner">biginner</option>
                    <option value="Intermediate">Intermediate</option>
                    <option value="Advanced">Advanced</option>
                  </select>
            </div>

            <!-- <div class="hero">
                    <label for="Github-url">Github-url:</label>
    
                    <input 
                         type="url" 
                         id="category-url" 
                         name="category_url" 
                         required
    >
            </div> -->

            <!-- Register Button -->
            <button type="submit" class="login-btn">Register</button>

            <!-- Back to Login Link -->
            <div class="register-link">
                <p>Already have an account? <a href="/">Login here</a></p>
            </div>
        </form>
    </div>

</body>
</html>
